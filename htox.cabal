cabal-version: 3.0
name:          htox
synopsis:      A Tox client for Android, in Haskell
version:       0.1.0
license:       GPL-3.0-only
build-type:    Simple
author:        iphy
maintainer:    iphy
copyright:     Copyright (c) 2026 The TokTok Team
homepage:      https://toktok.ltd
category:      Network

library
  default-language: Haskell2010
  hs-source-dirs:   src
  ghc-options:      -Wall
  exposed-modules:
    HTox.App
    HTox.Emoji
    HTox.Links
    HTox.Model
    HTox.Playback
    HTox.Private
    HTox.Store
    HTox.Theme
    HTox.Version
    HTox.View
  build-depends:
      base               <5
    , base16-bytestring  >=1
    , bytestring
    , containers
    , directory
    , filepath
    , hatter
    , saltine
    , sqlite-simple
    , stm
    , text
    , time
    , tox
    , toxav
    , toxcore
    , toxsync
    , vector
  if !os(windows)
    build-depends: unix

test-suite testsuite
  default-language:   Haskell2010
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  ghc-options:        -Wall
  main-is:            testsuite.hs
  other-modules:
    HTox.EmojiSpec
    HTox.LinksSpec
    HTox.Taps
    HTox.ModelSpec
    HTox.PlaybackSpec
    HTox.Sample
    HTox.StoreSpec
    HTox.ViewSpec
  build-depends:
      base               <5
    , base16-bytestring
    , bytestring
    , containers
    , directory
    , filepath
    , hatter
    , hspec
    , saltine
    , sqlite-simple
    , text
    , time
    , tox
    , toxav
    , toxcore
    , toxsync
    , unix
    , vector
    , htox
