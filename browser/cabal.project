-- For wasm32-wasi-cabal (shell.nix), with the libraries from their
-- checkouts.
packages:
  .
  ..
  ../../hs-tox
  ../../hs-toxav
  ../../hs-toxcore
  ../../hs-toxsync
  ../../third_party/hatter
  ../../third_party/hatter/browser

package toxcore
  flags: +library-only

-- The compiler's own, which the others can't be built in place of.
constraints:
  bytestring installed,
  containers installed,
  directory installed,
  filepath installed,
  process installed,
  text installed,
  time installed,
  unix installed
